.venv/
.claude/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
**/.pytest_cache/
.env
.env.local
.DS_Store
*.log
tests/
**/tests/
**/eval/
deployment/
**/deployment/
docs/
arivu/arivu_live.html
