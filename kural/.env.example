# ─────────────────────────────────────────────────────────────────────────────
# kural — environment (the only mouth)
#
# kural reads the SHARED saakshe config (common/config.py). Two run modes,
# auto-detected: if Vertex/Gemini creds resolve it runs LIVE, otherwise it falls
# back to a deterministic offline replay (demo) so the mouth still executes
# end-to-end (Parallel research / write↔fact-check Loop / eligibility gate /
# ledger / HITL publish gate all real; only LLM token generation is replayed).
# Force a mode with SAAKSHE_MODE.
# ─────────────────────────────────────────────────────────────────────────────

# live | demo | auto   (auto = live if creds resolve, else demo)
SAAKSHE_MODE=auto

# ── Google Cloud / Vertex AI ────────────────────────────────────────────────
# Set up ADC first:  gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Claude on Vertex lives in specific regions (us-east5 is the safe default).
SAAKSHE_CLAUDE_LOCATION=us-east5

# ── Models (shared across the company) ───────────────────────────────────────
SAAKSHE_MODEL_PRO=gemini-2.5-pro
SAAKSHE_MODEL_FLASH=gemini-2.5-flash
# Claude (Opus-class) via Vertex Model Garden for the two highest-stakes seats:
# the Envoy Lead (qualify) and the Claim-Judge (fact-check). Exactly two.
SAAKSHE_MODEL_CLAUDE=claude-opus-4-1@20250805

# ── Claim-Judge gate (the fact-check safety property) ─────────────────────────
SAAKSHE_CLAIM_THRESHOLD=0.80
SAAKSHE_MAX_CLAIM_ROUNDS=2

# ── Send safety: the before_tool eligibility / value-cap gate ─────────────────
# A single automated send may never exceed this notional value without a human.
KURAL_SEND_VALUE_CAP_USD=500

# ── Safety: world-facing side effects (send / publish) ───────────────────────
# dry_run = true  -> the mouth logs the send/publish it WOULD do, fires nothing.
# Real OAuth send / publish fire ONLY when this is false AND the founder approved
# at the publish gate (tap 2). Tests/eval must keep this true.
SAAKSHE_EXECUTOR_DRY_RUN=true

# ── Observability ────────────────────────────────────────────────────────────
SAAKSHE_OTEL_CONSOLE=true
