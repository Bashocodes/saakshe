# saakshe company-wide live config — Vertex AI. Demo stays the default (no
# GOOGLE_CLOUD_PROJECT here → creds_available() False → demo). The live run sets
# GOOGLE_CLOUD_PROJECT + SAAKSHE_MODE=live inline; these only matter when live.
GOOGLE_CLOUD_LOCATION=global
# Sonnet 4.6 supports the global endpoint; match the GLOBAL quota being raised.
SAAKSHE_CLAUDE_LOCATION=global
ARIVU_CLAUDE_LOCATION=global
# All 8 Claude·Vertex seats (2 per quadrant) run on Sonnet 4.6 (enabled in Model
# Garden for the example project, us-east5). arivu reads its own ARIVU_* vars.
SAAKSHE_MODEL_CLAUDE=claude-sonnet-4-6@default
ARIVU_MODEL_VERDICT=claude-sonnet-4-6@default
ARIVU_MODEL_PROSECUTOR=claude-sonnet-4-6@default
# NEWEST Gemini confirmed serving on this project (probe-verified 2026-06-08 via
# models.list() + newest-first sweep): Pro = gemini-3.1-pro-preview (3.1-pro & 3-pro
# both 404 here; the -preview answers), Flash = gemini-3.5-flash (3.5-flash-preview
# 404s; the bare 3.5-flash answers — newer than the old 3-flash-preview).
SAAKSHE_MODEL_PRO=gemini-3.1-pro-preview
SAAKSHE_MODEL_FLASH=gemini-3.5-flash
ARIVU_MODEL_CHAIR=gemini-3.1-pro-preview
ARIVU_MODEL_MANTRI=gemini-3.5-flash
