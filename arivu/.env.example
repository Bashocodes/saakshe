# ─────────────────────────────────────────────────────────────────────────────
# arivu — environment
#
# Two run modes. arivu auto-detects: if Vertex/Gemini creds resolve it runs LIVE,
# otherwise it falls back to a deterministic offline replay (demo) so the chamber
# still executes end-to-end (Parallel / Loop / escalate / HITL / executor all real;
# only the LLM token generation is replayed). Force a mode with ARIVU_MODE.
# ─────────────────────────────────────────────────────────────────────────────

# live | demo | auto   (auto = live if creds resolve, else demo)
ARIVU_MODE=auto

# ── Google Cloud / Vertex AI ────────────────────────────────────────────────
# Set up ADC first:  gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Claude on Vertex lives in specific regions (us-east5 is the safe default).
# Kept separate so Gemini (global / us-central1) and Claude (us-east5) can differ.
ARIVU_CLAUDE_LOCATION=us-east5

# ── Models ───────────────────────────────────────────────────────────────────
ARIVU_MODEL_CHAIR=gemini-2.5-pro
ARIVU_MODEL_MANTRI=gemini-2.5-flash
# Claude (Opus-class) via Vertex Model Garden for the two highest-stakes steps.
ARIVU_MODEL_VERDICT=claude-opus-4-1@20250805
ARIVU_MODEL_PROSECUTOR=claude-opus-4-1@20250805

# ── Grounding: example MCP (the org's own live numbers) ───────────────────────
# Secret lives on disk (chmod 600); never commit the value.
EXAMPLE_MCP_URL=https://mcp.example.com/mcp
EXAMPLE_MCP_SECRET_FILE=~/.example_mcp_secret

# ── Safety: executor side-effects ────────────────────────────────────────────
# dry_run = true  -> executor logs the actions it WOULD take, fires nothing.
# Real publish / planner / dispatch fire ONLY when this is false AND a human
# approval has landed at the single HITL gate. Tests/eval must keep this true.
ARIVU_EXECUTOR_DRY_RUN=true

# ── Thresholds (deterministic chamber math) ──────────────────────────────────
ARIVU_DEFENSIBILITY_THRESHOLD=0.80
ARIVU_CONVERGENCE_THRESHOLD=0.75
ARIVU_MAX_DEBATE_ROUNDS=3
ARIVU_MAX_PROSECUTION_ROUNDS=3

# ── Observability ────────────────────────────────────────────────────────────
ARIVU_OTEL_CONSOLE=true
ARIVU_BIGQUERY_DATASET=
